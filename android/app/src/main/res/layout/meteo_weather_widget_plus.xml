<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/meteo_widget_plus_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/meteo_widget_bg"
    android:gravity="top"
    android:minHeight="170dp"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/meteo_widget_plus_city"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Bratislava"
        android:textColor="#F5F5F5"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="Bratislava" />

    <TextView
        android:id="@+id/meteo_widget_plus_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:gravity="center"
        android:text="Pondelok 27. apríla, 09:43"
        android:textColor="#E6EDF5"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="Pondelok 27. apríla, 09:43" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="58dp"
            android:layout_height="58dp">

            <ImageView
                android:id="@+id/meteo_widget_plus_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/meteo_widget_icon_cd"
                android:scaleType="fitCenter"
                android:src="@drawable/meteo_w_cloud" />

            <TextView
                android:id="@+id/meteo_widget_plus_icon_dash"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="—"
                android:textColor="#CCFFFFFF"
                android:textSize="@dimen/meteo_widget_placeholder_dash_text_size"
                android:textStyle="normal"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/meteo_widget_plus_temp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-8dp"
        android:gravity="center"
        android:text="22°"
        android:textColor="#FFFFFF"
        android:textSize="30sp"
        android:textStyle="bold"
        tools:text="22°" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/meteo_widget_plus_apparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Pocitovo 21°"
            android:textColor="#E4EBF2"
            android:textSize="12sp"
            android:textStyle="bold"
            tools:text="Pocitovo 21°" />

        <TextView
            android:id="@+id/meteo_widget_plus_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Zamračené"
            android:textColor="#EAF1F8"
            android:textSize="12sp"
            tools:text="Zamračené" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/meteo_widget_hero_glass_info"
        android:gravity="center_vertical"
        android:minHeight="48dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.006"
                android:text="Vietor"
                android:textColor="#D1FFFFFF"
                android:textSize="11sp"
                android:textStyle="normal" />

            <TextView
                android:id="@+id/meteo_widget_plus_wind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="4 km/h"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="4 km/h" />
        </LinearLayout>

        <!-- RemoteViews: plain View nie je povolený; ImageView ako 1dp delič -->
        <ImageView
            android:layout_width="1dp"
            android:layout_height="30dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="#38FFFFFF"
            android:contentDescription="@null"
            android:focusable="false"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.006"
                android:text="Východ / západ"
                android:textColor="#D1FFFFFF"
                android:textSize="11sp"
                android:textStyle="normal" />

            <TextView
                android:id="@+id/meteo_widget_plus_sun"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:text="06:17 / 19:54"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="06:17 / 19:54" />
        </LinearLayout>

        <!-- RemoteViews: plain View nie je povolený; ImageView ako 1dp delič -->
        <ImageView
            android:layout_width="1dp"
            android:layout_height="30dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:background="#38FFFFFF"
            android:contentDescription="@null"
            android:focusable="false"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.006"
                android:text="Vlhkosť"
                android:textColor="#D1FFFFFF"
                android:textSize="11sp"
                android:textStyle="normal" />

            <TextView
                android:id="@+id/meteo_widget_plus_humidity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="81%"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="81%" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Layout ako hero karta v appke: teplota vľavo, ikona vpravo, metriky dole. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/meteo_widget_plus_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/meteo_widget_bg"
    android:gravity="top"
    android:minHeight="170dp"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/meteo_widget_plus_city"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Bratislava"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="Bratislava" />

    <TextView
        android:id="@+id/meteo_widget_plus_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="Pondelok 27. apríla, 09:43"
        android:textColor="#C8D4E0"
        android:textSize="11sp"
        android:textStyle="normal"
        tools:text="Pondelok 27. apríla, 09:43" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical|start"
            android:orientation="vertical">

            <TextView
                android:id="@+id/meteo_widget_plus_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:text="24°"
                android:textColor="#FFFFFF"
                android:textSize="44sp"
                android:textStyle="bold"
                tools:text="24°" />

            <TextView
                android:id="@+id/meteo_widget_plus_apparent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Pocitovo 26°"
                android:textColor="#DEE7F0"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Pocitovo 26°" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <FrameLayout
                android:layout_width="72dp"
                android:layout_height="72dp">

                <ImageView
                    android:id="@+id/meteo_widget_plus_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/meteo_widget_icon_cd"
                    android:scaleType="fitCenter"
                    android:src="@drawable/meteo_w_cloud" />

                <TextView
                    android:id="@+id/meteo_widget_plus_icon_dash"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="—"
                    android:textColor="#CCFFFFFF"
                    android:textSize="@dimen/meteo_widget_placeholder_dash_text_size"
                    android:textStyle="normal"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/meteo_widget_plus_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="Dážď"
                android:textColor="#EAF1F8"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Dážď" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/meteo_widget_hero_glass_info"
        android:gravity="center_vertical"
        android:minHeight="52dp"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.01"
                android:text="Vietor"
                android:textColor="#D1FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/meteo_widget_plus_wind"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="1 km/h"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="1 km/h" />
        </LinearLayout>

        <ImageView
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="#38FFFFFF"
            android:contentDescription="@null"
            android:focusable="false"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.15"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.01"
                android:text="Východ / západ"
                android:textColor="#D1FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/meteo_widget_plus_sun"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:text="05:30 / 21:04"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="05:30 / 21:04" />
        </LinearLayout>

        <ImageView
            android:layout_width="1dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="#38FFFFFF"
            android:contentDescription="@null"
            android:focusable="false"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.01"
                android:text="Vlhkosť"
                android:textColor="#D1FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/meteo_widget_plus_humidity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="61%"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="61%" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>

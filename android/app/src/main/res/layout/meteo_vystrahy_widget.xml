<?xml version="1.0" encoding="utf-8"?>
<!--
  Vonkajší FrameLayout s paddingom: Android 12+ oreže widget na systémové rohy
  a bez insetu oseká 2dp okraj (žltý/červený stroke).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/meteo_vystrahy_widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:padding="5dp">

    <LinearLayout
        android:id="@+id/meteo_vystrahy_widget_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/meteo_vystrahy_widget_bg_l1"
        android:gravity="center_vertical"
        android:minHeight="110dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp">

        <FrameLayout
            android:id="@+id/meteo_vystrahy_widget_icon_wrap"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/meteo_vystrahy_icon_circle_l1">

            <TextView
                android:id="@+id/meteo_vystrahy_widget_icon_glyph"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="⚠"
                android:textColor="#1A2430"
                android:textSize="20sp"
                android:textStyle="bold"
                tools:text="⚡" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/meteo_vystrahy_widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Búrky"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="2 výstrahy" />

            <TextView
                android:id="@+id/meteo_vystrahy_widget_level"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="1. stupeň • okres Prešov"
                android:textColor="#FACC15"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="najvyšší 2. stupeň • okres Prešov" />

            <TextView
                android:id="@+id/meteo_vystrahy_widget_types"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="5"
                android:text="Búrky · Platí do dnes 23:59"
                android:textColor="#EBFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/meteo_vystrahy_widget_timing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="3"
                android:text="Práve platí vo vašom okrese"
                android:textColor="#E6FFFFFF"
                android:textSize="12sp"
                tools:text="Od dnes 14:00 do 18:00 (o 2 h)" />
        </LinearLayout>

        <TextView
            android:id="@+id/meteo_vystrahy_widget_chevron"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:paddingStart="4dp"
            android:text="›"
            android:textColor="#FACC15"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>

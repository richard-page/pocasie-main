<?xml version="1.0" encoding="utf-8"?>
<!-- App Widget: žiadne layout_weight na prázdne View; koreň wrap_content. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/meteo_widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="145dp"
    android:background="@drawable/meteo_widget_bg"
    android:orientation="vertical"
    android:padding="10dp"
    android:gravity="top">

    <TextView
        android:id="@+id/meteo_widget_city"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Bratislava"
        android:textColor="#F5F5F5"
        android:textSize="17sp"
        android:textStyle="bold"
        tools:text="Bratislava" />

    <TextView
        android:id="@+id/meteo_widget_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textColor="#E6EDF5"
        android:textSize="12sp"
        android:textStyle="bold"
        android:text="Pondelok 27. apríla, 09:43"
        tools:text="Pondelok 27. apríla, 09:43" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:orientation="horizontal"
        android:gravity="center">

        <FrameLayout
            android:layout_width="74dp"
            android:layout_height="74dp">

            <ImageView
                android:id="@+id/meteo_widget_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/meteo_widget_icon_cd"
                android:scaleType="fitCenter"
                android:src="@drawable/meteo_w_cloud" />

            <TextView
                android:id="@+id/meteo_widget_icon_dash"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="—"
                android:textColor="#CCFFFFFF"
                android:textSize="@dimen/meteo_widget_placeholder_dash_text_size"
                android:textStyle="normal"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/meteo_widget_temp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="-12dp"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textSize="34sp"
        android:textStyle="bold"
        android:text="22°"
        tools:text="22°" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/meteo_widget_apparent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#E4EBF2"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="Pocitovo 21°"
            tools:text="Pocitovo 21°" />

        <TextView
            android:id="@+id/meteo_widget_desc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#EAF1F8"
            android:textSize="13sp"
            android:text="Zamračené"
            tools:text="Zamračené" />
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<!-- Štandardný widget — rovnaký hero štýl (teplota vľavo, ikona vpravo). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/meteo_widget_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="145dp"
    android:background="@drawable/meteo_widget_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingTop="12dp"
    android:paddingEnd="14dp"
    android:paddingBottom="14dp"
    android:gravity="top">

    <TextView
        android:id="@+id/meteo_widget_city"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Bratislava"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="Bratislava" />

    <TextView
        android:id="@+id/meteo_widget_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:textColor="#C8D4E0"
        android:textSize="11sp"
        android:textStyle="normal"
        android:text="Pondelok 27. apríla, 09:43"
        tools:text="Pondelok 27. apríla, 09:43" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical|start"
            android:orientation="vertical">

            <TextView
                android:id="@+id/meteo_widget_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:includeFontPadding="false"
                android:textColor="#FFFFFF"
                android:textSize="48sp"
                android:textStyle="bold"
                android:text="24°"
                tools:text="24°" />

            <TextView
                android:id="@+id/meteo_widget_apparent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#DEE7F0"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="Pocitovo 26°"
                tools:text="Pocitovo 26°" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="8dp">

            <FrameLayout
                android:layout_width="78dp"
                android:layout_height="78dp">

                <ImageView
                    android:id="@+id/meteo_widget_icon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/meteo_widget_icon_cd"
                    android:scaleType="fitCenter"
                    android:src="@drawable/meteo_w_cloud" />

                <TextView
                    android:id="@+id/meteo_widget_icon_dash"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="—"
                    android:textColor="#CCFFFFFF"
                    android:textSize="@dimen/meteo_widget_placeholder_dash_text_size"
                    android:textStyle="normal"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/meteo_widget_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#EAF1F8"
                android:textSize="13sp"
                android:textStyle="bold"
                android:text="Dážď"
                tools:text="Dážď" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>

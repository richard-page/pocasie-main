<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/meteo_widget_mini_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/meteo_widget_bg"
    android:gravity="top"
    android:minHeight="140dp"
    android:orientation="vertical"
    android:padding="8dp">

    <TextView
        android:id="@+id/meteo_widget_mini_city"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Bratislava"
        android:textColor="#F5F5F5"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/meteo_widget_mini_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:text="Pondelok 27. apríla, 09:43"
        android:textColor="#E6EDF5"
        android:textSize="11sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="5dp">

        <ImageView
            android:id="@+id/meteo_widget_mini_icon"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/meteo_widget_icon_cd"
            android:scaleType="fitCenter"
            android:src="@drawable/meteo_w_cloud" />

        <TextView
            android:id="@+id/meteo_widget_mini_icon_dash"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="—"
            android:textColor="#CCFFFFFF"
            android:textSize="@dimen/meteo_widget_placeholder_dash_text_size"
            android:textStyle="normal"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/meteo_widget_mini_temp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:text="22°"
        android:textColor="#FFFFFF"
        android:textSize="34sp"
        android:textStyle="bold" />

</LinearLayout>

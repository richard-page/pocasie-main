<?xml version="1.0" encoding="utf-8"?>
<!-- Údaje obnovuje aplikácia (interval z nastavení). Hodnota 0 = žiadne periodické systémové budenie (Android aj tak max. ~30 min). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="320dp"
    android:minHeight="180dp"
    android:minResizeWidth="280dp"
    android:minResizeHeight="150dp"
    android:updatePeriodMillis="0"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:initialLayout="@layout/meteo_weather_widget"
    android:previewLayout="@layout/meteo_weather_widget"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/meteo_widget_desc" />

<?xml version="1.0" encoding="utf-8"?>
<!-- Údaje obnovuje aplikácia (interval z nastavení). Hodnota 0 = žiadne periodické systémové budenie. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="320dp"
    android:minHeight="180dp"
    android:minResizeWidth="320dp"
    android:minResizeHeight="180dp"
    android:updatePeriodMillis="0"
    android:targetCellWidth="4"
    android:targetCellHeight="3"
    android:initialLayout="@layout/meteo_weather_widget_plus"
    android:previewLayout="@layout/meteo_weather_widget_plus"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:description="@string/meteo_widget_plus_desc" />
